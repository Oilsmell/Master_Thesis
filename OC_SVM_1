# MK-MMD 파라미터
SVM_NUM_SAMPLES    = 1000
SVM_PFA            = 0.05          # 5% FAR
SVM_OPTUNA_TRIAL   = 30            # 가속으로 trial 1회가 매우 빠름. 필요시 ↓
MAX_REF            = 300           # ref 서브샘플 크기 (가속 4)

# POD 평가 X축
x_range_r = np.linspace(0, 50, 200)
x_range_s = np.linspace(0, 100, 200)

SEED = 42
np.random.seed(SEED)

print("=" * 70)
print("  MK-MMD ACCELERATED PIPELINE")
print("=" * 70)


# ================================================================
# [1] 공통 POD 함수 (Heteroscedastic Censored MLE + Block Bootstrap)
# ================================================================
def _mll_loss(params, x, y, a_th):
    b0, b1, tau0, tau1 = params
    mu_y = b0 + b1 * x
    tau  = np.maximum(tau0 + tau1 * x, 1e-8)
    cens   = y <= a_th
    uncens = ~cens
    ll  = norm.logpdf(y[uncens], loc=mu_y[uncens], scale=tau[uncens])
    llc = norm.logcdf(a_th,      loc=mu_y[cens],   scale=tau[cens])
    return -(np.sum(ll) + np.sum(llc))

def fit_mle_pod(x, y, a_th):
    slope, intercept, *_ = linregress(x, y)
    init   = [intercept, slope, np.std(y), 0.0]
    bounds = [(None, None), (None, None), (1e-8, None), (0.0, None)]
    res    = minimize(_mll_loss, init, args=(x, y, a_th),
                      bounds=bounds, method='L-BFGS-B')
    return res.x, res.success

def get_mean_pod(x_range, params, a_th):
    b0, b1, t0, t1 = params
    mu  = b0 + b1 * x_range
    tau = np.maximum(t0 + t1 * x_range, 1e-8)
    return norm.cdf((mu - a_th) / tau)

def bootstrap_lcb(x, y, a_th, x_range, n_boot=300, block_size=None):
    n    = len(x)
    pods = []
    if block_size is None:
        for _ in range(n_boot):
            idx = np.random.choice(n, n, replace=True)
            p, ok = fit_mle_pod(x[idx], y[idx], a_th)
            if ok:
                pods.append(get_mean_pod(x_range, p, a_th))
    else:
        n_blocks = max(1, n // block_size)
        for _ in range(n_boot):
            starts = np.random.choice(max(1, n - block_size + 1), n_blocks, replace=True)
            idx    = np.concatenate([np.arange(s, s + block_size) for s in starts])
            idx    = idx[idx < n]
            if len(idx) < 10:
                continue
            p, ok  = fit_mle_pod(x[idx], y[idx], a_th)
            if ok:
                pods.append(get_mean_pod(x_range, p, a_th))
    if not pods:
        return np.zeros_like(x_range)
    return np.percentile(np.array(pods), 5, axis=0)

def compute_pod(all_a, all_ahat, a_th, x_range, n_boot=300, block_size=None):
    params, _ = fit_mle_pod(all_a, all_ahat, a_th)
    pod_mean  = get_mean_pod(x_range, params, a_th)
    pod_lcb   = bootstrap_lcb(all_a, all_ahat, a_th, x_range, n_boot, block_size)
    a90    = x_range[np.argmax(pod_mean >= 0.9)] if np.any(pod_mean >= 0.9) else np.nan
    a90_95 = x_range[np.argmax(pod_lcb  >= 0.9)] if np.any(pod_lcb  >= 0.9) else np.nan
    return pod_mean, pod_lcb, a90, a90_95, params


# ================================================================
# [2] 데이터 로더 (정규화 안 함, raw window 반환)
# ================================================================
def _windowize(data):
    ns = data.shape[1] // WINDOW_SIZE
    if ns == 0:
        return None, 0
    data = data[:, :ns * WINDOW_SIZE]
    return data.reshape(CHANNELS, ns, WINDOW_SIZE).transpose(1, 0, 2), ns

def load_data(path, is_synth=False):
    try:
        if is_synth:
            data = np.loadtxt(path, delimiter='\t').T.astype(np.float32)
        else:
            raw  = [float(line.split()[1]) for line in open(path, 'r') if len(line.split()) >= 2]
            data = np.array(raw, dtype=np.float32).reshape(CHANNELS, -1)
        windows, ns = _windowize(data)
        if windows is None:
            return None, 0
        if ns > SVM_NUM_SAMPLES and "healthyclean" not in path.lower():
            np.random.seed(42)
            windows = windows[np.random.choice(ns, SVM_NUM_SAMPLES, replace=False)]
            ns = SVM_NUM_SAMPLES
        return windows, ns
    except Exception as e:
        print(f"   Error loading {path}: {e}")
        return None, 0


# ================================================================
# [3] 특징 추출 (시간 / 주파수 / Hilbert / 교차채널 상관)
#     교차채널 상관 루프 → einsum 벡터화 (가속)
# ================================================================
def extract_features(data):
    if len(data) == 0:
        return np.array([])

    # ── 시간 도메인
    mean_v = np.mean(data, axis=2)
    std_v  = np.std(data, axis=2)
    rms_v  = np.sqrt(np.mean(data**2, axis=2))
    peak_v = np.max(np.abs(data), axis=2)
    p2p_v  = np.ptp(data, axis=2)
    crest_v = peak_v / (rms_v + 1e-10)
    centered = data - mean_v[:, :, None]
    skew_v = np.mean(centered**3, axis=2) / (std_v**3 + 1e-10)
    kurt_v = np.mean(centered**4, axis=2) / (std_v**4 + 1e-10)
    zcr_v  = np.mean(np.abs(np.diff(np.sign(data), axis=2)), axis=2) / 2

    # ── 주파수 도메인
    fft_mag  = np.abs(np.fft.rfft(data, axis=-1))
    freqs    = np.fft.rfftfreq(WINDOW_SIZE)
    fft_sum  = np.sum(fft_mag, axis=2) + 1e-10
    centroid = np.sum(freqs * fft_mag, axis=2) / fft_sum
    spread   = np.sqrt(np.sum(((freqs - centroid[..., None])**2) * fft_mag, axis=2) / fft_sum)
    p_norm   = fft_mag / fft_sum[..., None]
    sp_ent   = -np.sum(p_norm * np.log2(p_norm + 1e-10), axis=2)
    hf_ratio = np.sum(fft_mag[:, :, fft_mag.shape[-1]//2:], axis=2) / fft_sum

    # ── Band ratios (4 bands)
    n_bands     = 4
    band_edges  = np.linspace(0, fft_mag.shape[2], n_bands + 1, dtype=int)
    band_ratios = []
    for i in range(n_bands):
        band_e = np.sum(fft_mag[:, :, band_edges[i]:band_edges[i+1]], axis=2)
        band_ratios.append(band_e / fft_sum)

    # ── Hilbert envelope
    env       = np.abs(hilbert(data, axis=-1))
    env_rms   = np.sqrt(np.mean(env**2, axis=2))
    env_mean  = np.mean(env, axis=2)
    env_std   = np.std(env, axis=2)
    env_kurt  = np.mean((env - env_mean[..., None])**4, axis=2) / (env_std**4 + 1e-10)

    # ── 교차채널 상관 (벡터화: 루프 제거)
    T        = data.shape[2]
    dc       = data - data.mean(axis=2, keepdims=True)          # (N, C, T)
    sd       = dc.std(axis=2) + 1e-10                            # (N, C)
    zc       = dc / sd[:, :, None]                               # 표준화
    corr     = np.einsum('nct,ndt->ncd', zc, zc) / T            # (N, C, C) 상관행렬
    triu_idx = np.triu_indices(CHANNELS, k=1)
    corr_feats = corr[:, triu_idx[0], triu_idx[1]]              # (N, 28)

    return np.concatenate([mean_v, std_v, rms_v, peak_v, p2p_v, crest_v, skew_v, kurt_v, zcr_v,
                           centroid, spread, sp_ent, hf_ratio, np.concatenate(band_ratios, axis=1),
                           env_rms, env_mean, env_std, env_kurt, corr_feats], axis=1)


# ================================================================
# [4] 가속 MMD 스코어러
# ================================================================
def precompute_ref(ref_dist, base_gamma, max_ref=MAX_REF, seed=SEED):
    """ref-ref 항은 chunk와 무관한 상수 → 1번만 계산. ref는 서브샘플."""
    if len(ref_dist) > max_ref:
        rng = np.random.default_rng(seed)
        ref_dist = ref_dist[rng.choice(len(ref_dist), max_ref, replace=False)]
    gammas   = [base_gamma * 0.1, base_gamma, base_gamma * 10]
    ref_sqd  = euclidean_distances(ref_dist, ref_dist, squared=True)   # 1번
    xx_means = [float(np.exp(-g * ref_sqd).mean()) for g in gammas]    # gamma별 상수
    return ref_dist, gammas, xx_means

def get_mmd_scores_fast(features, ref_cache, chunk_size, stride=2):
    """슬라이딩 윈도우 MMD. ref-ref는 캐시, sqdist는 gamma 3개에 재사용."""
    ref_dist, gammas, xx_means = ref_cache
    n = len(features)
    if n < chunk_size:
        return np.array([])
    scores = []
    for i in range(0, n - chunk_size + 1, stride):
        chunk = features[i:i + chunk_size]
        d_yy  = euclidean_distances(chunk, chunk, squared=True)        # 1번
        d_xy  = euclidean_distances(ref_dist, chunk, squared=True)     # 1번
        total = 0.0
        for g, xxm in zip(gammas, xx_means):
            total += xxm + np.exp(-g * d_yy).mean() - 2.0 * np.exp(-g * d_xy).mean()
        scores.append(total)
    return np.array(scores)


# ================================================================
# [5] 데이터 준비: 정상 train/val 분할 + 스케일
# ================================================================
print("\n[1] 특징 추출 및 스케일링...")
all_h, _ = load_data(os.path.join(DIR_B_RAW, FILE_B))
np.random.seed(42)
np.random.shuffle(all_h)
split_idx   = int(len(all_h) * 0.7)
train_h_raw = all_h[:split_idx]
val_h_raw   = all_h[split_idx:]
print(f"    Train: {train_h_raw.shape}, Val: {val_h_raw.shape}")

train_feat = extract_features(train_h_raw)
val_feat   = extract_features(val_h_raw)

# Optuna 목표 타겟: synth DI 0.50 (없으면 real D3_48)
target_raw, _ = load_data(os.path.join(SYNTH_DATA_DIR, "Synthetic_B_DI_0.50.txt"), is_synth=True)
if target_raw is None:
    target_raw, _ = load_data(os.path.join(DIR_B_RAW, "D3_48_1.txt"))
target_feat = extract_features(target_raw)

scaler        = RobustScaler()
train_scaled  = scaler.fit_transform(train_feat)
val_scaled    = scaler.transform(val_feat)
target_scaled = scaler.transform(target_feat)


# ================================================================
# [6] Optuna 최적화 (가속 스코어러 사용)
# ================================================================
print("\n[2] Optuna 최적화...")

def objective(trial):
    pca_comp   = trial.suggest_int('pca_comp', 15, 60)
    chunk_size = trial.suggest_int('chunk_size', 20, 80, step=10)
    gamma_mult = trial.suggest_float('gamma_mult', 0.01, 10.0, log=True)

    pca        = PCA(n_components=pca_comp, random_state=42)
    train_pca  = pca.fit_transform(train_scaled)
    val_pca    = pca.transform(val_scaled)
    target_pca = pca.transform(target_scaled)

    base_gamma = (1.0 / (np.median(pdist(train_pca, metric='sqeuclidean')) + 1e-10)) * gamma_mult

    ref_cache   = precompute_ref(train_pca, base_gamma)   # trial당 1번, val·target 공유
    stride_eval = max(1, chunk_size // 2)
    v_scores = get_mmd_scores_fast(val_pca,    ref_cache, chunk_size, stride=stride_eval)
    t_scores = get_mmd_scores_fast(target_pca, ref_cache, chunk_size, stride=stride_eval)

    if len(v_scores) < 5 or len(t_scores) < 5:
        return -999.0
    return (np.mean(t_scores) - np.mean(v_scores)) / (np.std(v_scores) + 1e-6)

study = optuna.create_study(direction='maximize')
with tqdm(total=SVM_OPTUNA_TRIAL, desc="  Optuna") as pbar:
    study.optimize(objective, n_trials=SVM_OPTUNA_TRIAL,
                   callbacks=[lambda s, t: pbar.update(1)])

best = study.best_params
print(f"  최적: PCA={best['pca_comp']}, Chunk={best['chunk_size']}, "
      f"Gamma×={best['gamma_mult']:.4f}")


# ================================================================
# [7] 최적 파라미터 적용 + 임계값 (ref-cache 1번만 생성)
# ================================================================
print("\n[3] 최적 파라미터 적용...")
pca_final   = PCA(n_components=best['pca_comp'], random_state=42)
train_final = pca_final.fit_transform(train_scaled)
val_final   = pca_final.transform(val_scaled)

base_gamma  = 1.0 / (np.median(pdist(train_final, metric='sqeuclidean')) + 1e-10)
final_gamma = base_gamma * best['gamma_mult']
final_chunk = best['chunk_size']

# 전체 평가에서 ref·gamma 고정 → 단 1번만 precompute
ref_cache_final = precompute_ref(train_final, final_gamma)
eval_stride     = max(1, final_chunk // 2)   # 가속 3: 자기상관 중복 제거

val_scores = get_mmd_scores_fast(val_final, ref_cache_final, final_chunk, stride=2)
threshold  = np.percentile(val_scores, (1 - SVM_PFA) * 100)
print(f"  임계값 (FAR={SVM_PFA*100:.0f}%): {threshold:.4f}  | eval stride={eval_stride}")


# ================================================================
# [8] (a, â) 수집
# ================================================================
print("\n[4] 손상 데이터 평가...")
real_a, real_ahat   = [], []
synth_a, synth_ahat = [], []

for case in tqdm(DAMAGE_CASES_B, desc="  Real"):
    d, _ = load_data(os.path.join(DIR_B_RAW, f"D3_{case}_1.txt"))
    if d is not None:
        feat   = pca_final.transform(scaler.transform(extract_features(d)))
        scores = get_mmd_scores_fast(feat, ref_cache_final, final_chunk, stride=eval_stride)
        real_a.extend([case] * len(scores))
        real_ahat.extend(scores.tolist())

for di in tqdm(SYNTHETIC_DI_STEPS, desc="  Synth"):
    d, _ = load_data(os.path.join(SYNTH_DATA_DIR, f"Synthetic_B_DI_{di:.2f}.txt"), is_synth=True)
    if d is not None:
        feat   = pca_final.transform(scaler.transform(extract_features(d)))
        scores = get_mmd_scores_fast(feat, ref_cache_final, final_chunk, stride=eval_stride)
        synth_a.extend([di * 100.0] * len(scores))
        synth_ahat.extend(scores.tolist())

real_a  = np.array(real_a);  real_ahat  = np.array(real_ahat)
synth_a = np.array(synth_a); synth_ahat = np.array(synth_ahat)


# ================================================================
# [9] POD 계산 (block bootstrap, block_size=chunk)
# ================================================================
print("\n[5] POD 계산...")
pod_mean_r, pod_lcb_r, a90_r, a90_95_r, params_r = \
    compute_pod(real_a, real_ahat, threshold, x_range_r, block_size=final_chunk)
pod_mean_s, pod_lcb_s, a90_s, a90_95_s, params_s = \
    compute_pod(synth_a, synth_ahat, threshold, x_range_s, block_size=final_chunk)

print(f"  ✅ MK-MMD POD | Real a90={a90_r:.1f}% | Synth a90={a90_s:.1f}%")


# ================================================================
# [10] 시각화: â vs a 산점 + POD 커브 (Real / Synth)
# ================================================================
print("\n[6] 시각화...")
COLOR_R, COLOR_S = '#2ECC71', '#16A085'

def plot_scatter(ax, x, y, params, a_th, title, xlabel, xlim, color):
    b0, b1, t0, t1 = params
    ax.scatter(x, y, alpha=0.12, color=color, s=10, label='Data points')
    xr   = np.linspace(0, xlim, 100)
    mu   = b0 + b1 * xr
    tau  = np.maximum(t0 + t1 * xr, 1e-8)
    ax.plot(xr, mu, 'k-', linewidth=2.5, label='MLE Mean')
    ax.plot(xr, mu + 2*tau, 'k--', linewidth=1.2, alpha=0.7, label=r'$\pm 2\sigma$')
    ax.plot(xr, mu - 2*tau, 'k--', linewidth=1.2, alpha=0.7)
    ax.fill_between(xr, mu - 2*tau, mu + 2*tau, color='gray', alpha=0.1)
    ax.axhline(a_th, color='red', linestyle='-', linewidth=2, label=f'Threshold = {a_th:.2f}')
    ax.set_title(title, fontweight='bold')
    ax.set_xlabel(xlabel); ax.set_ylabel(r'MMD Score, $\hat{a}$')
    ax.set_xlim([0, xlim]); ax.grid(True, linestyle=':', alpha=0.7)
    ax.legend(loc='upper left', fontsize=9)

def plot_pod(ax, xr, pm, pl, a90, a90_95, title, xlabel, xlim, color):
    lbl_m = f'Mean POD ($a_{{90}}$={a90:.1f}%)' if not np.isnan(a90) else 'Mean POD (N/A)'
    lbl_l = f'95% LCB ($a_{{90/95}}$={a90_95:.1f}%)' if not np.isnan(a90_95) else '95% LCB (N/A)'
    ax.plot(xr, pm, color=color, linewidth=3, label=lbl_m)
    ax.plot(xr, pl, color=color, linewidth=2, linestyle='--', label=lbl_l)
    ax.axhline(0.9, color='black', linestyle=':', linewidth=1.5, label='90% Target')
    if not np.isnan(a90) and a90 < xlim:
        ax.axvline(a90, color=color, linestyle=':', alpha=0.5)
    ax.set_title(title, fontweight='bold')
    ax.set_xlabel(xlabel); ax.set_ylabel('Probability of Detection')
    ax.set_ylim([0, 1.05]); ax.set_xlim([0, xlim])
    ax.grid(True, linestyle=':', alpha=0.7); ax.legend(loc='lower right', fontsize=9)

fig, axes = plt.subplots(2, 2, figsize=(16, 12))
plot_scatter(axes[0, 0], real_a,  real_ahat,  params_r, threshold,
             "Real Data: â vs a + MLE Fit", "Damage Case, $a$ (%)", 50, COLOR_R)
plot_scatter(axes[0, 1], synth_a, synth_ahat, params_s, threshold,
             "Synthetic Data: â vs a + MLE Fit", "Mapped Synthetic Damage, $a$ (%)", 100, COLOR_S)
plot_pod(axes[1, 0], x_range_r, pod_mean_r, pod_lcb_r, a90_r, a90_95_r,
         "Real Data: POD Curve", "Damage Case, $a$ (%)", 50, COLOR_R)
plot_pod(axes[1, 1], x_range_s, pod_mean_s, pod_lcb_s, a90_s, a90_95_s,
         "Synthetic Data: POD Curve", "Mapped Synthetic Damage, $a$ (%)", 100, COLOR_S)

plt.tight_layout()
fig_path = os.path.join(SAVE_DIR, "MK_MMD_POD.png")
